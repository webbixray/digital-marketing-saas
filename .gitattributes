# Auto detect text files and perform LF normalization
* text=el

# PHP files
*.php text eol=lf diff=php

# JavaScript files
*.js text eol=lf

# CSS files
*.css text eol=lf

# JSON files
*.json text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files
*.md text eol=lf

# Blade templates
*.blade.php text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
*.sqlite binary
*.db binary
