# Production Environment Configuration
# Copy this to .env and update values for your deployment

APP_NAME="Digital Marketing SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Bcrypt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Logging - production values
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_strong_password

# Session (Redis recommended for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com

# Cache & Queue (Redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Mail (SMTP - Mailgun/SES/Postmark)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@your-domain.com
MAIL_PASSWORD=your_mailgun_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# File Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (LIVE keys for production)
STRIPE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# Stripe Price IDs
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_STARTER_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxxxxxxxxxxx

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SEND_DEFAULT_PII=false

# AI Providers
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ENABLED=false

# Social Media APIs
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Telescope (disable in production)
TELESCOPE_ENABLED=false

# Feature Flags
FEATURE_AI_CONTENT=true
FEATURE_SOCIAL_POSTING=true
FEATURE_EMAIL_CAMPAIGNS=true
FEATURE_ANALYTICS=true
FEATURE_WORKFLOWS=true
