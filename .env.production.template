# Digital Marketing SaaS — Production Environment Template
# =============================================
# Copy to .env.production and fill in all values
# NEVER commit actual secrets to version control!

# ---------------------------------------------
# Application
# ---------------------------------------------
APP_NAME="Digital Marketing SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE  # Run: php artisan key:generate --show

# ---------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=digital_marketing_saas
DB_USERNAME=digital_marketing_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ---------------------------------------------
# Redis
# ---------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD
REDIS_CLIENT=phpredis

# ---------------------------------------------
# Cache & Session
# ---------------------------------------------
CACHE_DRIVER=redis
CACHE_PREFIX=digital_marketing_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# ---------------------------------------------
# Queue
# ---------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# ---------------------------------------------
# Mail (SMTP)
# ---------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="Digital Marketing SaaS"

# ---------------------------------------------
# Stripe
# ---------------------------------------------
STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ---------------------------------------------
# AWS S3 (File Storage)
# ---------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=digital-marketing-saas-production
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------
# Sentry (Error Tracking)
# ---------------------------------------------
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---------------------------------------------
# Broadcasting (Reverb)
# ---------------------------------------------
BROADCAST_DRIVER=reverb
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ---------------------------------------------
# Logging
# ---------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=info
LOG_DAYS=30

# ---------------------------------------------
# Security
# ---------------------------------------------
# CSP handled by middleware
# HSTS handled by nginx
# Rate limiting handled by nginx + Laravel

# ---------------------------------------------
# Feature Flags
# ---------------------------------------------
FEATURE_AI_CAMPAIGNS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_TEAM_COLLABORATION=true

# ---------------------------------------------
# Backup (configure in backup scripts)
# ---------------------------------------------
BACKUP_S3_BUCKET=digital-marketing-saas-backups
BACKUP_RETENTION_DAYS=30